params {
    max_cpus = 32   // override on CLI: --max_cpus N
}

profiles {
    slurm {
        process {
            executor       = 'slurm'
            queue          = 'epyc'
            clusterOptions = '-N 1 -n 1'
            shell          = ['/bin/bash', '-l']
            errorStrategy  = { task.attempt < 3 ? 'retry' : 'finish' }
            maxRetries     = 2
        }
        executor {
            queueSize       = 200
            submitRateLimit = '20/1min'
        }
    }

    local {
        process.executor = 'local'
        process.shell    = ['/bin/bash', '-l']
        executor {
            cpus   = params.max_cpus
            memory = '500 GB'
        }
    }

    funannotate {
        workDir = "${launchDir}/work.funannotate"
        cleanup = true
        process {
            withName: 'SETUP_TAXONDB' {
                queue  = 'short'
                memory = '1 GB'
                time   = '30m'
            }
            withName: 'GENOME_CLEAN' {
                queue  = 'highmem'
                memory = '32 GB'
                time   = '6h'
            }
            withName: 'SRA_FETCH' {
                queue  = 'short'
                memory = '8 GB'
                time   = '2h'
            }
            withName: 'FUNANNOTATE_TRAIN' {
                queue  = 'epyc'
                memory = '96 GB'
                time   = '72h'
            }
            withName: 'FUNANNOTATE_PREDICT' {
                queue  = 'epyc'
                memory = '32 GB'
                time   = '72h'
            }
            withName: 'SIGNALP_RUN' {
                queue          = 'gpu'
                cpus           = 16
                memory         = '64 GB'
                time           = '4h'
                clusterOptions = '--gres=gpu:a100:1 -N 1 -n 1'
            }
            withName: 'INTERPROSCAN_RUN' {
                queue  = 'epyc'
                cpus   = 8
                memory = '32 GB'
                time   = '60h'
            }
            withName: 'ANTISMASH_RUN' {
                queue  = 'epyc'
                memory = '24 GB'
                time   = '8h'
            }
            withName: 'FUNANNOTATE_ANNOTATE' {
                queue  = 'epyc'
                memory = '64 GB'
                time   = '24h'
            }
        }
        report {
            enabled   = true
            file      = "${launchDir}/logs/funannotate-report.html"
            overwrite = true
        }
        trace {
            enabled   = true
            file      = "${launchDir}/logs/funannotate-trace.txt"
            overwrite = true
        }
    }

    interproscan6 {
        workDir = "${launchDir}/work.interproscan6"
        process {
            withName: 'INTERPROSCAN6_RUN' {
                queue  = 'epyc'
                cpus   = 16
                memory = '64 GB'
                time   = '72h'
            }
        }
        report {
            enabled   = true
            file      = "${launchDir}/logs/interproscan6-report.html"
            overwrite = true
        }
        trace {
            enabled   = true
            file      = "${launchDir}/logs/interproscan6-trace.txt"
            overwrite = true
        }
    }
}

singularity {
    enabled      = false
    autoMounts   = true
    cacheDir     = '/bigdata/stajichlab/shared/lib/singularity_cache'
    envWhitelist = 'SCRATCH'
}

// NXF_EXIT_STATUS_READ_TIMEOUT_MILLIS must be set in the launch shell environment,
// not here. Add to your sbatch script: export NXF_EXIT_STATUS_READ_TIMEOUT_MILLIS=150000
